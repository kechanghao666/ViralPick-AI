# Runtime
VIRALPICK_ENV=production
VIRALPICK_VERSION=0.2.0
VIRALPICK_LOG_LEVEL=INFO

# Flask local runner
VIRALPICK_API_HOST=127.0.0.1
VIRALPICK_API_PORT=5000
VIRALPICK_DEBUG=0

# Data paths
VIRALPICK_DB_PATH=data/database/viralpick.db
VIRALPICK_PROCESSED_DATA_DIR=data/processed
VIRALPICK_MAX_UPLOAD_MB=10
VIRALPICK_BACKUP_DIR=data/backups
VIRALPICK_BACKUP_RETENTION=10

# Monitoring alert webhook
# Generic JSON webhook. Keep real URLs in local .env or deployment secrets.
VIRALPICK_ALERTS_ENABLED=0
VIRALPICK_ALERT_WEBHOOK_URL=
VIRALPICK_ALERT_MIN_SEVERITY=warn
VIRALPICK_ALERT_TIMEOUT_SECONDS=8

# Scheduled report delivery
# SMTP credentials must come from local .env or deployment secrets.
VIRALPICK_PUBLIC_BASE_URL=http://127.0.0.1:5000
VIRALPICK_REPORT_DELIVERY_ENABLED=0
VIRALPICK_REPORT_DELIVERY_AUTO_RETRY_ENABLED=1
VIRALPICK_REPORT_DELIVERY_MAX_RETRY_ATTEMPTS=3
VIRALPICK_REPORT_DELIVERY_RETRY_BACKOFF_MINUTES=5,30,120
VIRALPICK_SMTP_HOST=
VIRALPICK_SMTP_PORT=587
VIRALPICK_SMTP_USERNAME=
VIRALPICK_SMTP_PASSWORD=
VIRALPICK_SMTP_FROM_EMAIL=reports@viralpick.local
VIRALPICK_SMTP_USE_TLS=1
VIRALPICK_SMTP_USE_SSL=0
VIRALPICK_SMTP_TIMEOUT_SECONDS=10

# CORS
# Use "*" for local demos. For production, set explicit origins such as:
# VIRALPICK_CORS_ORIGINS=https://app.example.com,https://admin.example.com
VIRALPICK_CORS_ORIGINS=*

# Serve frontend through Flask/Gunicorn for one-container demos.
VIRALPICK_SERVE_FRONTEND=1
VIRALPICK_FRONTEND_DIR=frontend

# Authentication
# Production defaults to auth required. Set to 0 only for local public demos.
VIRALPICK_AUTH_REQUIRED=1
VIRALPICK_AUTH_TOKEN_TTL_HOURS=168
VIRALPICK_AUTH_MAX_FAILED_ATTEMPTS=5
VIRALPICK_AUTH_LOCKOUT_MINUTES=15
VIRALPICK_DEFAULT_ADMIN_EMAIL=demo@viralpick.ai
VIRALPICK_DEFAULT_ADMIN_PASSWORD=ViralPick@2026

# Rate limiting
# The built-in limiter is process-local. For multi-instance production, also configure gateway/Redis rate limiting.
VIRALPICK_RATE_LIMIT_ENABLED=1
VIRALPICK_RATE_LIMIT_WINDOW_SECONDS=60
VIRALPICK_RATE_LIMIT_DEFAULT_PER_WINDOW=300
VIRALPICK_RATE_LIMIT_AUTH_PER_WINDOW=20
VIRALPICK_RATE_LIMIT_WRITE_PER_WINDOW=120

# LLM report enhancement
# Keep real credentials in a local .env file or VIRALPICK_LLM_CONFIG_FILE, never in source code.
VIRALPICK_LLM_ENABLED=0
VIRALPICK_LLM_PROVIDER=spark-x
VIRALPICK_LLM_MODEL=x2
VIRALPICK_LLM_ENDPOINT=https://spark-api-open.xf-yun.com/x2/chat/completions
VIRALPICK_LLM_API_PASSWORD=
VIRALPICK_LLM_TIMEOUT_SECONDS=30
# Optional local file path. In development, ../API.txt is also detected automatically when present.
# VIRALPICK_LLM_CONFIG_FILE=E:\2026实训\API.txt
